                  {
                    "key": "patientName",
                    "type": "text",
                    "label": "Patient Name",
                    "required": true,
                    "placeholder": "Patients Name"
                  },
                  {
                    "key": "contactDetails",
                    "type": "textarea",
                    "label": "Contact Details",
                    "required": true,
                    "placeholder": "Enter details of contacting"
                  },
